<file path="scripts/generate-icons.mjs">
// Generates the Stash PWA icon set from inline SVG using sharp.
// Run with: node scripts/generate-icons.mjs
import sharp from 'sharp'
import { writeFile } from 'node:fs/promises'
import { fileURLToPath } from 'node:url'
import { dirname, join } from 'node:path'

const root = join(dirname(fileURLToPath(import.meta.url)), '..')
const pub = join(root, 'public')

const VIOLET = '#7C3AED'
const VIOLET_DARK = '#6D28D9'
const VIOLET_LIGHT = '#A78BFA'

// A clean bookmark glyph centered in a `size`x`size` viewbox.
function bookmark(size, { rounded }) {
  const r = rounded ? size * 0.22 : 0
  // Bookmark occupies the central ~46% so it stays inside the maskable safe zone.
  const bw = size * 0.32
  const bh = size * 0.46
  const x = (size - bw) / 2
  const y = (size - bh) / 2
  const notch = bh * 0.26
  return `
<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 ${size} ${size}">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="${VIOLET_LIGHT}"/>
      <stop offset="0.5" stop-color="${VIOLET}"/>
      <stop offset="1" stop-color="${VIOLET_DARK}"/>
    </linearGradient>
  </defs>
  <rect width="${size}" height="${size}" rx="${r}" ry="${r}" fill="url(#bg)"/>
  <path
    d="M ${x} ${y + bw * 0.18}
       a ${bw * 0.18} ${bw * 0.18} 0 0 1 ${bw * 0.18} -${bw * 0.18}
       h ${bw - bw * 0.36}
       a ${bw * 0.18} ${bw * 0.18} 0 0 1 ${bw * 0.18} ${bw * 0.18}
       V ${y + bh}
       L ${x + bw / 2} ${y + bh - notch}
       L ${x} ${y + bh}
       Z"
    fill="#ffffff"/>
</svg>`
}

const tasks = [
  { name: 'pwa-192x192.png', size: 192, rounded: true },
  { name: 'pwa-512x512.png', size: 512, rounded: true },
  { name: 'maskable-512x512.png', size: 512, rounded: false },
  { name: 'apple-touch-icon.png', size: 180, rounded: true },
]

for (const t of tasks) {
  const svg = Buffer.from(bookmark(t.size, { rounded: t.rounded }))
  await sharp(svg).png().toFile(join(pub, t.name))
  console.log('wrote', t.name)
}

// Crisp SVG favicon (scales to any size in the browser tab).
await writeFile(join(pub, 'favicon.svg'), bookmark(64, { rounded: true }).trim())
console.log('wrote favicon.svg')
</file>

