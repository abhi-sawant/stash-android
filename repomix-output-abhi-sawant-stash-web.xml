<file path="src/components/masonry.tsx">
import { useMemo } from 'react'
import { useMediaQuery } from '@/hooks/use-media-query'

/** Matches the native app's responsive column counts. */
function useColumnCount(): number {
  const xl = useMediaQuery('(min-width: 1280px)')
  const lg = useMediaQuery('(min-width: 900px)')
  const md = useMediaQuery('(min-width: 600px)')
  if (xl) return 4
  if (lg) return 3
  if (md) return 2
  return 2
}

/**
 * A responsive masonry grid. Items are distributed round-robin across columns
 * (so the newest items stay along the top row), exactly like the native app.
 */
export function Masonry<T>({
  items,
  getKey,
  renderItem,
}: {
  items: T[]
  getKey: (item: T) => string
  renderItem: (item: T) => React.ReactNode
}) {
  const numCols = useColumnCount()

  const columns = useMemo(() => {
    const cols: T[][] = Array.from({ length: numCols }, () => [])
    items.forEach((item, i) => cols[i % numCols].push(item))
    return cols
  }, [items, numCols])

  return (
    <div className="flex items-start gap-3">
      {columns.map((col, ci) => (
        <div key={ci} className="flex min-w-0 flex-1 flex-col gap-3">
          {col.map((item) => (
            <div key={getKey(item)}>{renderItem(item)}</div>
          ))}
        </div>
      ))}
    </div>
  )
}
</file>

