<file path="src/pages/settings-page.tsx">
import { useState } from 'react'
import { useNavigate } from 'react-router-dom'
import {
  Bookmark as BookmarkIcon,
  CloudUpload,
  Download,
  LogIn,
  LogOut,
  Monitor,
  Moon,
  Sun,
  UserPlus,
  Upload,
  Loader2,
} from 'lucide-react'
import { toast } from 'sonner'
import { Page, PageHeader } from '@/components/layout/page'
import { useAuth } from '@/lib/auth-context'
import { useBookmarks } from '@/lib/context'
import { useConfirm } from '@/components/confirm-dialog'
import { downloadBackup, restoreFromBackup } from '@/lib/backup'
import { loadBookmarks, loadCollections, loadSettings } from '@/lib/storage'
import { fetchAndMerge, getLastSyncTime, uploadBackup, uploadData } from '@/lib/sync'
import type { AppSettings } from '@/lib/types'
import { cn } from '@/lib/utils'

const THEME_OPTIONS: { label: string; value: AppSettings['themePreference']; icon: typeof Sun }[] = [
  { label: 'Light', value: 'light', icon: Sun },
  { label: 'Dark', value: 'dark', icon: Moon },
  { label: 'System', value: 'system', icon: Monitor },
]

export function SettingsPage() {
  const navigate = useNavigate()
  const confirm = useConfirm()
  const { user, logout } = useAuth()
  const { settings, updateSettings, bookmarks, collections, restore } = useBookmarks()

  const [syncing, setSyncing] = useState(false)
  const [restoring, setRestoring] = useState(false)
  const [lastSync, setLastSync] = useState<string | null>(() => {
    const ts = getLastSyncTime()
    return ts ? new Date(ts).toLocaleString() : null
  })

  const handleSync = async () => {
    setSyncing(true)
    try {
      const local = { bookmarks, collections, settings }
      const result = await fetchAndMerge(local)
      if (result) {
        restore(result.merged)
        await uploadData(result.merged)
      } else {
        await uploadBackup()
      }
      const ts = getLastSyncTime()
      if (ts) setLastSync(new Date(ts).toLocaleString())
      toast.success('Synced', { description: 'Your bookmarks are backed up to the cloud.' })
    } catch (e) {
      toast.error('Sync failed', { description: (e as Error).message ?? 'Could not connect to the server.' })
    } finally {
      setSyncing(false)
    }
  }

  const handleLogout = async () => {
    const ok = await confirm({ title: 'Sign out', description: 'Are you sure you want to sign out?', confirmText: 'Sign out', destructive: true })
    if (ok) {
      logout()
      toast.success('Signed out')
    }
  }

  const handleExport = () => {
    downloadBackup()
    toast.success('Backup downloaded', { description: 'Saved as a JSON file to your downloads.' })
  }

  const handleRestore = async () => {
    const ok = await confirm({
      title: 'Restore backup',
      description: 'This replaces all current bookmarks and collections with the backup data. This cannot be undone.',
      confirmText: 'Choose file',
      destructive: true,
    })
    if (!ok) return
    setRestoring(true)
    try {
      const restored = await restoreFromBackup()
      if (restored) {
        restore({ bookmarks: loadBookmarks(), collections: loadCollections(), settings: loadSettings() })
        toast.success('Backup restored')
      }
    } catch (e) {
      toast.error('Restore failed', { description: (e as Error).message ?? 'Invalid or corrupted backup file' })
    } finally {
      setRestoring(false)
    }
  }

  return (
    <Page>
      <PageHeader title="Settings" />

      <div className="space-y-7 pt-2">
        {/* Account */}
        <Section title="Account">
          {user ? (
            <Card>
              <Row icon={<Avatar email={user.email} />}>
                <div className="min-w-0">
                  <p className="truncate text-sm font-medium text-foreground">{user.email}</p>
                  <p className="text-xs text-muted-foreground">{lastSync ? `Last synced: ${lastSync}` : 'Not synced yet'}</p>
                </div>
              </Row>
              <button
                type="button"
                disabled={syncing}
                onClick={handleSync}
                className="flex w-full items-center gap-3 border-t border-border px-4 py-3.5 text-left transition-colors hover:bg-accent/50 disabled:opacity-60"
              >
                <Glyph className="bg-blue-500/15 text-blue-600 dark:text-blue-400">
                  {syncing ? <Loader2 className="size-[4.5] animate-spin" /> : <CloudUpload className="size-[4.5]" />}
                </Glyph>
                <div className="flex-1">
                  <p className="text-sm font-medium text-foreground">Sync now</p>
                  <p className="text-xs text-muted-foreground">Upload a backup to the cloud</p>
                </div>
              </button>
              <button
                type="button"
                onClick={handleLogout}
                className="flex w-full items-center gap-3 border-t border-border px-4 py-3.5 text-left transition-colors hover:bg-accent/50"
              >
                <Glyph className="bg-destructive/15 text-destructive">
                  <LogOut className="size-[4.5]" />
                </Glyph>
                <p className="text-sm font-medium text-destructive">Sign out</p>
              </button>
            </Card>
          ) : (
            <Card>
              <Row icon={<Glyph className="bg-primary/15 text-primary"><CloudUpload className="size-[4.5]" /></Glyph>}>
                <div>
                  <p className="text-sm font-medium text-foreground">Cloud backup</p>
                  <p className="text-xs text-muted-foreground">Sign in to back up and sync across devices.</p>
                </div>
              </Row>
              <LinkRow icon={<Glyph className="bg-primary/15 text-primary"><LogIn className="size-[4.5]" /></Glyph>} label="Sign in" onClick={() => navigate('/auth/login')} />
              <LinkRow icon={<Glyph className="bg-primary/15 text-primary"><UserPlus className="size-[4.5]" /></Glyph>} label="Create account" onClick={() => navigate('/auth/register')} />
            </Card>
          )}
        </Section>

        {/* Appearance */}
        <Section title="Appearance">
          <div className="grid grid-cols-3 gap-2 rounded-2xl border border-border bg-card p-2">
            {THEME_OPTIONS.map((opt) => {
              const active = settings.themePreference === opt.value
              return (
                <button
                  key={opt.value}
                  type="button"
                  onClick={() => updateSettings({ themePreference: opt.value })}
                  className={cn(
                    'flex flex-col items-center gap-2 rounded-xl py-4 text-sm font-medium transition-colors',
                    active ? 'bg-primary text-primary-foreground' : 'text-muted-foreground hover:bg-accent',
                  )}
                >
                  <opt.icon className="size-5" />
                  {opt.label}
                </button>
              )
            })}
          </div>
        </Section>

        {/* Backup & Restore */}
        <Section title="Backup & Restore">
          <Card>
            <div className="grid grid-cols-2 divide-x divide-border border-b border-border">
              <Stat value={bookmarks.length} label="Bookmarks" />
              <Stat value={collections.length} label="Collections" />
            </div>
            <button
              type="button"
              onClick={handleExport}
              className="flex w-full items-center gap-3 border-b border-border px-4 py-3.5 text-left transition-colors hover:bg-accent/50"
            >
              <Glyph className="bg-emerald-500/15 text-emerald-600 dark:text-emerald-400"><Download className="size-[4.5]" /></Glyph>
              <div className="flex-1">
                <p className="text-sm font-medium text-foreground">Export backup</p>
                <p className="text-xs text-muted-foreground">Download all bookmarks as a JSON file</p>
              </div>
            </button>
            <button
              type="button"
              disabled={restoring}
              onClick={handleRestore}
              className="flex w-full items-center gap-3 px-4 py-3.5 text-left transition-colors hover:bg-accent/50 disabled:opacity-60"
            >
              <Glyph className="bg-amber-500/15 text-amber-600 dark:text-amber-400">
                {restoring ? <Loader2 className="size-[4.5] animate-spin" /> : <Upload className="size-[4.5]" />}
              </Glyph>
              <div className="flex-1">
                <p className="text-sm font-medium text-foreground">Restore backup</p>
                <p className="text-xs text-muted-foreground">Import bookmarks from a backup file</p>
              </div>
            </button>
          </Card>
        </Section>

        {/* About */}
        <Section title="About">
          <Card>
            <div className="flex items-center gap-4 p-4">
              <span className="flex size-14 items-center justify-center rounded-2xl bg-primary text-primary-foreground">
                <BookmarkIcon className="size-7" fill="currentColor" strokeWidth={0} />
              </span>
              <div>
                <p className="font-heading text-base font-semibold text-foreground">Stash</p>
                <p className="text-xs text-muted-foreground">Version 1.0.0</p>
                <p className="text-xs text-muted-foreground">A modern, easy-to-use bookmark manager</p>
              </div>
            </div>
          </Card>
        </Section>
      </div>
    </Page>
  )
}

function Section({ title, children }: { title: string; children: React.ReactNode }) {
  return (
    <section className="space-y-2">
      <h2 className="px-1 text-xs font-semibold tracking-wider text-primary uppercase">{title}</h2>
      {children}
    </section>
  )
}

function Card({ children }: { children: React.ReactNode }) {
  return <div className="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">{children}</div>
}

function Row({ icon, children }: { icon: React.ReactNode; children: React.ReactNode }) {
  return (
    <div className="flex items-center gap-3 px-4 py-3.5">
      {icon}
      {children}
    </div>
  )
}

function LinkRow({ icon, label, onClick }: { icon: React.ReactNode; label: string; onClick: () => void }) {
  return (
    <button
      type="button"
      onClick={onClick}
      className="flex w-full items-center gap-3 border-t border-border px-4 py-3.5 text-left transition-colors hover:bg-accent/50"
    >
      {icon}
      <span className="text-sm font-medium text-primary">{label}</span>
    </button>
  )
}

function Glyph({ children, className }: { children: React.ReactNode; className?: string }) {
  return <span className={cn('flex size-9 shrink-0 items-center justify-center rounded-lg', className)}>{children}</span>
}

function Avatar({ email }: { email: string }) {
  return (
    <span className="flex size-9 shrink-0 items-center justify-center rounded-lg bg-primary/15 text-xs font-semibold text-primary uppercase">
      {email.slice(0, 2)}
    </span>
  )
}

function Stat({ value, label }: { value: number; label: string }) {
  return (
    <div className="flex flex-col items-center gap-0.5 py-4">
      <span className="font-heading text-2xl font-bold text-primary">{value}</span>
      <span className="text-xs text-muted-foreground">{label}</span>
    </div>
  )
}
