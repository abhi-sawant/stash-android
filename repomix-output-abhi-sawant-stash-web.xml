import { lazy, Suspense } from 'react'
import { BrowserRouter, Navigate, Route, Routes } from 'react-router-dom'
import { Loader2 } from 'lucide-react'

import { AuthProvider } from '@/lib/auth-context'
import { BookmarksProvider, useBookmarks } from '@/lib/context'
import { ThemeProvider } from '@/components/theme-provider'
import { ConfirmProvider } from '@/components/confirm-dialog'
import { Toaster } from '@/components/ui/sonner'
import { ReloadPrompt } from '@/components/reload-prompt'
import { useBackgroundSync } from '@/hooks/use-background-sync'

import { AppShell } from '@/components/layout/app-shell'
import { BookmarksPage } from '@/pages/bookmarks-page'

// Code-split the less-frequent routes so the first paint stays small.
const CollectionsPage = lazy(() => import('@/pages/collections-page').then((m) => ({ default: m.CollectionsPage })))
const CollectionDetailPage = lazy(() =>
  import('@/pages/collection-detail-page').then((m) => ({ default: m.CollectionDetailPage })),
)
const SearchPage = lazy(() => import('@/pages/search-page').then((m) => ({ default: m.SearchPage })))
const SettingsPage = lazy(() => import('@/pages/settings-page').then((m) => ({ default: m.SettingsPage })))
const BookmarkFormPage = lazy(() =>
  import('@/pages/bookmark-form-page').then((m) => ({ default: m.BookmarkFormPage })),
)
const CollectionFormPage = lazy(() =>
  import('@/pages/collection-form-page').then((m) => ({ default: m.CollectionFormPage })),
)
const LoginPage = lazy(() => import('@/pages/auth/login-page').then((m) => ({ default: m.LoginPage })))
const RegisterPage = lazy(() => import('@/pages/auth/register-page').then((m) => ({ default: m.RegisterPage })))
const OtpPage = lazy(() => import('@/pages/auth/otp-page').then((m) => ({ default: m.OtpPage })))
const ForgotPasswordPage = lazy(() =>
  import('@/pages/auth/forgot-password-page').then((m) => ({ default: m.ForgotPasswordPage })),
)
const ResetPasswordPage = lazy(() =>
  import('@/pages/auth/reset-password-page').then((m) => ({ default: m.ResetPasswordPage })),
)

function Spinner() {
  return (
    <div className="flex min-h-dvh items-center justify-center bg-background">
      <Loader2 className="size-6 animate-spin text-primary" />
    </div>
  )
}

function AppRoutes() {
  useBackgroundSync()

  return (
    <Suspense fallback={<Spinner />}>
      <Routes>
        <Route element={<AppShell />}>
          <Route index element={<BookmarksPage />} />
          <Route path="collections" element={<CollectionsPage />} />
          <Route path="collections/:id" element={<CollectionDetailPage />} />
          <Route path="search" element={<SearchPage />} />
          <Route path="settings" element={<SettingsPage />} />
        </Route>

        {/* Focused, full-screen routes (no app chrome) */}
        <Route path="bookmark/new" element={<BookmarkFormPage />} />
        <Route path="bookmark/:id" element={<BookmarkFormPage />} />
        <Route path="collections/new" element={<CollectionFormPage />} />
        <Route path="collections/:id/edit" element={<CollectionFormPage />} />

        <Route path="auth/login" element={<LoginPage />} />
        <Route path="auth/register" element={<RegisterPage />} />
        <Route path="auth/otp" element={<OtpPage />} />
        <Route path="auth/forgot-password" element={<ForgotPasswordPage />} />
        <Route path="auth/reset-password" element={<ResetPasswordPage />} />

        <Route path="*" element={<Navigate to="/" replace />} />
      </Routes>
    </Suspense>
  )
}

/** Sits inside the data providers so it can resolve the theme from settings. */
function ThemedApp() {
  const { settings, loading } = useBookmarks()

  return (
    <ThemeProvider preference={settings.themePreference}>
      <ConfirmProvider>
        {loading ? <Spinner /> : <AppRoutes />}
        <Toaster position="top-center" />
        <ReloadPrompt />
      </ConfirmProvider>
    </ThemeProvider>
  )
}

export default function App() {
  return (
    <BrowserRouter>
      <AuthProvider>
        <BookmarksProvider>
          <ThemedApp />
        </BookmarksProvider>
      </AuthProvider>
    </BrowserRouter>
  )
}
</file>

