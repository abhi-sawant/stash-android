<file path="backend/api/thumbnails/upload.php">
<?php
/**
 * POST /api/thumbnails/upload
 * Header: Authorization: Bearer <token>
 * Body:   multipart/form-data
 *           bookmark_id  string   UUID of the bookmark
 *           image        file     JPEG, PNG, or WebP; max MAX_THUMBNAIL_SIZE_MB  (exclusive with image_url)
 *           image_url    string   External image URL to download server-side      (exclusive with image)
 *
 * Saves the image to disk at uploads/thumbnails/<user_id>/<bookmark_id>.<ext>
 * and upserts the public URL in the thumbnails table.
 *
 * Returns: { "url": "<public image URL>" }
 */

require_once __DIR__ . '/../../middleware/cors.php';
require_once __DIR__ . '/../../middleware/auth.php';
require_once __DIR__ . '/../../config/database.php';
require_once __DIR__ . '/../../config/config.php';

if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    http_response_code(405);
    echo json_encode(['error' => 'Method not allowed']);
    exit;
}

$authData   = requireAuth();
$userId     = (int)$authData['user_id'];
$bookmarkId = trim($_POST['bookmark_id'] ?? '');

// Only allow UUID-safe characters to prevent path traversal
if (!preg_match('/^[a-zA-Z0-9\-_]{1,64}$/', $bookmarkId)) {
    http_response_code(400);
    echo json_encode(['error' => 'Invalid bookmark_id']);
    exit;
}

$isUrlDownload  = false;
$tmpFileToClean = null;

if (!empty($_FILES['image']) && $_FILES['image']['error'] !== UPLOAD_ERR_NO_FILE) {
    // ── Path A: multipart file upload ─────────────────────────────────────────
    $file = $_FILES['image'];

    if ($file['error'] !== UPLOAD_ERR_OK) {
        http_response_code(400);
        echo json_encode(['error' => 'File upload error (code ' . $file['error'] . ')']);
        exit;
    }

    if ($file['size'] > MAX_THUMBNAIL_SIZE_MB * 1024 * 1024) {
        http_response_code(413);
        echo json_encode(['error' => 'Image exceeds the maximum allowed size of ' . MAX_THUMBNAIL_SIZE_MB . 'MB']);
        exit;
    }
} else {
    // ── Path B: server-side URL download ──────────────────────────────────────
    $remoteUrl = trim($_POST['image_url'] ?? '');

    if (empty($remoteUrl) || !filter_var($remoteUrl, FILTER_VALIDATE_URL)) {
        http_response_code(400);
        echo json_encode(['error' => 'Provide either an image file or a valid image_url']);
        exit;
    }

    if (!preg_match('/^https?:\/\//i', $remoteUrl)) {
        http_response_code(400);
        echo json_encode(['error' => 'image_url must be an http or https URL']);
        exit;
    }

    if (!function_exists('curl_init')) {
        http_response_code(500);
        echo json_encode(['error' => 'Server cannot fetch remote images (cURL unavailable)']);
        exit;
    }

    $ch = curl_init($remoteUrl);
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_FOLLOWLOCATION => true,
        CURLOPT_MAXREDIRS      => 5,
        CURLOPT_TIMEOUT        => 15,
        CURLOPT_SSL_VERIFYPEER => true,
        CURLOPT_SSL_VERIFYHOST => 2,
        CURLOPT_USERAGENT      => 'StashBot/1.0',
    ]);
    $imageData = curl_exec($ch);
    $httpCode  = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $curlError = curl_error($ch);
    curl_close($ch);

    if ($imageData === false || !empty($curlError)) {
        http_response_code(422);
        echo json_encode(['error' => 'Could not download image: ' . $curlError]);
        exit;
    }

    if ($httpCode < 200 || $httpCode >= 300) {
        http_response_code(422);
        echo json_encode(['error' => 'Remote URL returned HTTP ' . $httpCode]);
        exit;
    }

    if (strlen($imageData) > MAX_THUMBNAIL_SIZE_MB * 1024 * 1024) {
        http_response_code(413);
        echo json_encode(['error' => 'Remote image exceeds the maximum allowed size of ' . MAX_THUMBNAIL_SIZE_MB . 'MB']);
        exit;
    }

    $tmpFile = tempnam(sys_get_temp_dir(), 'stash_img_');
    if ($tmpFile === false || file_put_contents($tmpFile, $imageData) === false) {
        http_response_code(500);
        echo json_encode(['error' => 'Could not buffer remote image']);
        exit;
    }

    $file           = ['tmp_name' => $tmpFile, 'size' => strlen($imageData), 'error' => UPLOAD_ERR_OK];
    $isUrlDownload  = true;
    $tmpFileToClean = $tmpFile;
}

// Validate real MIME type using finfo — never trust the client-supplied type
$finfo    = new finfo(FILEINFO_MIME_TYPE);
$mimeType = $finfo->file($file['tmp_name']);
$extMap   = ['image/jpeg' => 'jpg', 'image/png' => 'png', 'image/webp' => 'webp'];

if (!isset($extMap[$mimeType])) {
    if ($tmpFileToClean) @unlink($tmpFileToClean);
    http_response_code(415);
    echo json_encode(['error' => 'Unsupported image type. Allowed: JPEG, PNG, WebP.']);
    exit;
}

$ext     = $extMap[$mimeType];
$userDir = __DIR__ . '/../../uploads/thumbnails/' . $userId;

if (!is_dir($userDir) && !mkdir($userDir, 0755, true)) {
    if ($tmpFileToClean) @unlink($tmpFileToClean);
    http_response_code(500);
    echo json_encode(['error' => 'Could not create upload directory']);
    exit;
}

$filename = $bookmarkId . '.' . $ext;
$destPath = $userDir . '/' . $filename;

// Remove any existing file for this bookmark with a different extension
foreach (['jpg', 'png', 'webp'] as $oldExt) {
    $old = $userDir . '/' . $bookmarkId . '.' . $oldExt;
    if ($old !== $destPath && file_exists($old)) {
        @unlink($old);
    }
}

if ($isUrlDownload) {
    // rename() can fail across filesystem boundaries; fall back to copy + unlink
    $saved = @rename($tmpFileToClean, $destPath);
    if (!$saved) {
        $saved = copy($tmpFileToClean, $destPath);
        @unlink($tmpFileToClean);
    }
} else {
    $saved = move_uploaded_file($file['tmp_name'], $destPath);
}

if (!$saved) {
    http_response_code(500);
    echo json_encode(['error' => 'Failed to save image to disk']);
    exit;
}

// Ensure the file is readable by the web server (PHP may leave it 0600)
@chmod($destPath, 0644);

$scheme   = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ? 'https' : 'http';
$host     = $_SERVER['HTTP_HOST'];
$publicUrl = $scheme . '://' . $host . '/uploads/thumbnails/' . $userId . '/' . $filename;

$db   = getDB();
$stmt = $db->prepare('
    INSERT INTO thumbnails (user_id, bookmark_id, image_url)
    VALUES (?, ?, ?)
    ON DUPLICATE KEY UPDATE image_url = VALUES(image_url), updated_at = CURRENT_TIMESTAMP
');
$stmt->bind_param('iss', $userId, $bookmarkId, $publicUrl);
$stmt->execute();
$stmt->close();
$db->close();

echo json_encode(['url' => $publicUrl]);
</file>

