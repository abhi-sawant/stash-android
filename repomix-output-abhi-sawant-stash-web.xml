import { exportAllData, importAllData } from './storage'
import type { BackupData } from './types'

function getBackupFilename() {
  return `stash-backup-${new Date().toISOString().split('T')[0]}.json`
}

/** Triggers a browser download of the full data backup as a JSON file. */
export function downloadBackup(): void {
  const data = exportAllData()
  const json = JSON.stringify(data, null, 2)
  const blob = new Blob([json], { type: 'application/json' })
  const url = URL.createObjectURL(blob)
  const a = document.createElement('a')
  a.href = url
  a.download = getBackupFilename()
  document.body.appendChild(a)
  a.click()
  a.remove()
  // Revoke on the next tick so the download has a chance to start.
  setTimeout(() => URL.revokeObjectURL(url), 1000)
}

/**
 * Opens a file picker and restores the chosen backup file into local storage.
 * Resolves to `true` if a file was restored, `false` if the user cancelled.
 */
export function restoreFromBackup(): Promise<boolean> {
  return new Promise((resolve, reject) => {
    const input = document.createElement('input')
    input.type = 'file'
    input.accept = 'application/json,.json'
    let settled = false

    input.onchange = async () => {
      const file = input.files?.[0]
      if (!file) {
        if (!settled) resolve(false)
        return
      }
      try {
        const text = await file.text()
        const data = JSON.parse(text) as BackupData
        importAllData(data)
        settled = true
        resolve(true)
      } catch {
        reject(new Error('Invalid or corrupted backup file'))
      }
    }

    // If the dialog is dismissed without choosing a file, resolve(false) shortly after focus returns.
    window.addEventListener(
      'focus',
      () => {
        setTimeout(() => {
          if (!settled && !input.files?.length) resolve(false)
        }, 500)
      },
      { once: true },
    )

    input.click()
  })
}
</file>

