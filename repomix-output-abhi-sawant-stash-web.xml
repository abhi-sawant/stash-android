import { useMemo } from 'react'
import { useNavigate } from 'react-router-dom'
import { FolderPlus, Plus } from 'lucide-react'
import { toast } from 'sonner'
import { Page, PageHeader } from '@/components/layout/page'
import { CollectionCard } from '@/components/collection-card'
import { EmptyState } from '@/components/empty-state'
import { Fab } from '@/components/fab'
import { Button } from '@/components/ui/button'
import { useBookmarks } from '@/lib/context'
import { useConfirm } from '@/components/confirm-dialog'
import type { Collection } from '@/lib/types'

export function CollectionsPage() {
  const navigate = useNavigate()
  const confirm = useConfirm()
  const { collections, bookmarks, deleteCollection } = useBookmarks()

  const counts = useMemo(() => {
    const map = new Map<string, number>()
    for (const b of bookmarks) if (b.collectionId) map.set(b.collectionId, (map.get(b.collectionId) ?? 0) + 1)
    return map
  }, [bookmarks])

  const handleDelete = async (col: Collection) => {
    const count = counts.get(col.id) ?? 0
    const ok = await confirm({
      title: 'Delete collection',
      description: `Delete “${col.name}”?${count > 0 ? ` ${count} bookmark${count > 1 ? 's' : ''} will be unassigned.` : ''}`,
      confirmText: 'Delete',
      destructive: true,
    })
    if (ok) {
      deleteCollection(col.id)
      toast.success('Collection deleted')
    }
  }

  return (
    <Page>
      <PageHeader
        title="Collections"
        subtitle={`${collections.length} ${collections.length === 1 ? 'collection' : 'collections'}`}
        actions={
          <Button size="icon-lg" aria-label="New collection" onClick={() => navigate('/collections/new')} className="lg:hidden">
            <Plus className="size-5" />
          </Button>
        }
      />

      {collections.length === 0 ? (
        <EmptyState
          icon={FolderPlus}
          title="No collections yet"
          subtitle="Create your first collection to organize your links."
          action={
            <Button className="gap-2" onClick={() => navigate('/collections/new')}>
              <Plus className="size-4" />
              New collection
            </Button>
          }
        />
      ) : (
        <div className="grid grid-cols-1 gap-3 pt-2 sm:grid-cols-2 xl:grid-cols-3">
          {collections.map((col) => (
            <CollectionCard
              key={col.id}
              collection={col}
              bookmarkCount={counts.get(col.id) ?? 0}
              onOpen={() => navigate(`/collections/${col.id}`)}
              onEdit={() => navigate(`/collections/${col.id}/edit`)}
              onDelete={() => handleDelete(col)}
            />
          ))}
        </div>
      )}

      <Fab icon={Plus} label="New collection" onClick={() => navigate('/collections/new')} />
    </Page>
  )
}
</file>

