/**
 * Reads an image File and returns a downscaled JPEG/PNG data URL. Downscaling
 * keeps custom cover images small so they don't bloat the JSON backup (which the
 * server caps at 10MB).
 */
export function fileToDataUrl(file: File, maxDim = 1280, quality = 0.82): Promise<string> {
  return new Promise((resolve, reject) => {
    const reader = new FileReader()
    reader.onerror = () => reject(new Error('Could not read the image file'))
    reader.onload = () => {
      const src = reader.result as string
      const img = new Image()
      img.onerror = () => reject(new Error('Could not load the image'))
      img.onload = () => {
        const scale = Math.min(1, maxDim / Math.max(img.width, img.height))
        const w = Math.round(img.width * scale)
        const h = Math.round(img.height * scale)
        const canvas = document.createElement('canvas')
        canvas.width = w
        canvas.height = h
        const ctx = canvas.getContext('2d')
        if (!ctx) return resolve(src)
        ctx.drawImage(img, 0, 0, w, h)
        const hasAlpha = file.type === 'image/png'
        resolve(canvas.toDataURL(hasAlpha ? 'image/png' : 'image/jpeg', quality))
      }
      img.src = src
    }
    reader.readAsDataURL(file)
  })
}
