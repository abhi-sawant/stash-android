<file path="backend/api/thumbnails/delete.php">
<?php
/**
 * DELETE /api/thumbnails
 * Header: Authorization: Bearer <token>
 * Body: { "bookmark_ids": ["<uuid>", ...] }
 *
 * Deletes image files from disk and removes the corresponding DB rows.
 * Call this when the user deletes a bookmark or clears its cover image.
 *
 * Returns: { "deleted": <number of rows removed> }
 */

require_once __DIR__ . '/../../middleware/cors.php';
require_once __DIR__ . '/../../middleware/auth.php';
require_once __DIR__ . '/../../config/database.php';

if ($_SERVER['REQUEST_METHOD'] !== 'DELETE') {
    http_response_code(405);
    echo json_encode(['error' => 'Method not allowed']);
    exit;
}

$authData = requireAuth();
$userId   = (int)$authData['user_id'];

$input = json_decode(file_get_contents('php://input'), true);

if (!isset($input['bookmark_ids']) || !is_array($input['bookmark_ids']) || count($input['bookmark_ids']) === 0) {
    http_response_code(400);
    echo json_encode(['error' => 'Missing required field: bookmark_ids (must be a non-empty array)']);
    exit;
}

$ids = array_values(array_filter(array_map('strval', $input['bookmark_ids'])));

if (count($ids) === 0) {
    echo json_encode(['deleted' => 0]);
    exit;
}

$db = getDB();

// Fetch image_url for each row before deleting so we can remove the files
$placeholders = implode(',', array_fill(0, count($ids), '?'));
$types        = 'i' . str_repeat('s', count($ids));
$params       = array_merge([$userId], $ids);

$stmt = $db->prepare("SELECT image_url FROM thumbnails WHERE user_id = ? AND bookmark_id IN ($placeholders)");
$stmt->bind_param($types, ...$params);
$stmt->execute();
$result = $stmt->get_result();
$urls   = [];
while ($row = $result->fetch_assoc()) {
    $urls[] = $row['image_url'];
}
$stmt->close();

// Delete the DB rows
$stmt = $db->prepare("DELETE FROM thumbnails WHERE user_id = ? AND bookmark_id IN ($placeholders)");
$stmt->bind_param($types, ...$params);
$stmt->execute();
$deleted = $stmt->affected_rows;
$stmt->close();
$db->close();

// Remove files from disk (best-effort — don't fail the response if a file is missing)
foreach ($urls as $url) {
    // Convert the public URL back to an absolute filesystem path
    // URL format: https://<host>/uploads/thumbnails/<user_id>/<file>
    $parsed = parse_url($url);
    if (!$parsed || empty($parsed['path'])) continue;

    // DOCUMENT_ROOT is the web root; uploads/ sits directly inside it
    $filePath = rtrim($_SERVER['DOCUMENT_ROOT'], '/') . $parsed['path'];

    // Safety check: path must stay within the uploads/thumbnails/<user_id>/ directory
    $allowed = realpath(__DIR__ . '/../../uploads/thumbnails/' . $userId);
    $real    = realpath($filePath);
    if ($real && $allowed && str_starts_with($real, $allowed . DIRECTORY_SEPARATOR)) {
        @unlink($real);
    }
}

echo json_encode(['deleted' => $deleted]);
</file>

