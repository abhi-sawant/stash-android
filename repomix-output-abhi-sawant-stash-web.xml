            <SearchIcon className="size-9" />
          </div>
          <h3 className="font-heading text-lg font-semibold">Search your bookmarks</h3>
          <p className="max-w-xs text-sm text-muted-foreground">Find links by title, URL, or description.</p>
          <div className="mt-4 flex gap-3">
            <Stat value={bookmarks.length} label="Links" />
            <Stat value={collections.length} label="Collections" />
