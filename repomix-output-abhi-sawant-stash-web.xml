import { useState } from 'react'
import { Check, ChevronDown, Plus, ArrowLeft } from 'lucide-react'
import { Dialog, DialogContent } from '@/components/ui/dialog'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import { Label } from '@/components/ui/label'
import { ColorPicker, IconPicker } from '@/components/pickers'
import { CollectionIcon } from '@/components/collection-icon'
import { useBookmarks } from '@/lib/context'
import { COLLECTION_COLORS, COLLECTION_ICONS } from '@/lib/collections'
import { cn } from '@/lib/utils'

export function CollectionPicker({
  value,
  onChange,
  allowNone = false,
  invalid = false,
}: {
  value: string | null
  onChange: (id: string | null) => void
  allowNone?: boolean
  invalid?: boolean
}) {
  const { collections, addCollection } = useBookmarks()
  const [open, setOpen] = useState(false)
  const [mode, setMode] = useState<'list' | 'create'>('list')

  const [name, setName] = useState('')
  const [color, setColor] = useState<string>(COLLECTION_COLORS[0])
  const [icon, setIcon] = useState<string>(COLLECTION_ICONS[0])

  const selected = collections.find((c) => c.id === value)

  const resetCreate = () => {
    setName('')
    setColor(COLLECTION_COLORS[0])
    setIcon(COLLECTION_ICONS[0])
  }

  const handleCreate = () => {
    if (!name.trim()) return
    const id = addCollection({ name: name.trim(), color, icon })
    onChange(id)
    resetCreate()
    setMode('list')
    setOpen(false)
  }

  return (
    <>
      <button
        type="button"
        onClick={() => {
          setMode('list')
          setOpen(true)
        }}
        aria-invalid={invalid}
        className={cn(
          'flex h-11 w-full items-center gap-2 rounded-xl border border-input bg-card px-3 text-sm transition-colors hover:border-ring/60 aria-invalid:border-destructive',
        )}
      >
        {selected ? (
          <>
            <span className="size-3 shrink-0 rounded-full" style={{ backgroundColor: selected.color }} />
            <span className="truncate text-foreground">{selected.name}</span>
          </>
        ) : (
          <span className="text-muted-foreground">Select a collection</span>
        )}
        <ChevronDown className="ml-auto size-4 shrink-0 text-muted-foreground" />
      </button>

      <Dialog open={open} onOpenChange={setOpen}>
        <DialogContent showCloseButton={false} className="gap-0 p-0 sm:max-w-md">
          {mode === 'list' ? (
            <div className="flex max-h-[70vh] flex-col">
              <div className="border-b p-4">
                <h2 className="font-heading text-base font-semibold">Select collection</h2>
              </div>
              <div className="flex-1 overflow-y-auto p-2">
                {allowNone ? (
                  <button
                    type="button"
                    onClick={() => {
                      onChange(null)
                      setOpen(false)
                    }}
                    className="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm hover:bg-accent"
                  >
                    <span className="text-muted-foreground">No collection</span>
                    {value === null ? <Check className="ml-auto size-4 text-primary" /> : null}
                  </button>
                ) : null}
                {collections.map((col) => (
                  <button
                    key={col.id}
                    type="button"
                    onClick={() => {
                      onChange(col.id)
                      setOpen(false)
                    }}
                    className="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm hover:bg-accent"
                  >
                    <span
                      className="flex size-7 items-center justify-center rounded-lg"
                      style={{ backgroundColor: `${col.color}20`, color: col.color }}
                    >
                      <CollectionIcon name={col.icon} className="size-4" />
                    </span>
                    <span className="truncate text-foreground">{col.name}</span>
                    {value === col.id ? <Check className="ml-auto size-4 text-primary" /> : null}
                  </button>
                ))}
                {collections.length === 0 && !allowNone ? (
                  <p className="px-3 py-6 text-center text-sm text-muted-foreground">
                    No collections yet. Create your first one below.
                  </p>
                ) : null}
              </div>
              <div className="border-t p-2">
                <Button
                  variant="ghost"
                  className="h-10 w-full justify-start gap-2 text-primary"
                  onClick={() => setMode('create')}
                >
                  <Plus className="size-4" />
                  New collection
                </Button>
              </div>
            </div>
          ) : (
            <div className="flex max-h-[80vh] flex-col">
              <div className="flex items-center gap-2 border-b p-3">
                <Button variant="ghost" size="icon-sm" onClick={() => setMode('list')} aria-label="Back">
                  <ArrowLeft />
                </Button>
                <h2 className="font-heading text-base font-semibold">New collection</h2>
                <Button
                  className="ml-auto"
                  size="sm"
                  disabled={!name.trim()}
                  onClick={handleCreate}
                >
                  Create
                </Button>
              </div>
              <div className="flex-1 space-y-5 overflow-y-auto p-4">
                <div className="flex flex-col items-center gap-2">
                  <span
                    className="flex size-16 items-center justify-center rounded-2xl"
                    style={{ backgroundColor: `${color}20`, color }}
                  >
                    <CollectionIcon name={icon} className="size-7" />
                  </span>
                </div>
                <div className="space-y-2">
                  <Label htmlFor="new-col-name">Collection name</Label>
                  <Input
                    id="new-col-name"
                    autoFocus
                    value={name}
                    onChange={(e) => setName(e.target.value)}
                    placeholder="e.g. Work, Reading, Recipes…"
                    onKeyDown={(e) => e.key === 'Enter' && handleCreate()}
                  />
                </div>
                <div className="space-y-2">
                  <Label>Color</Label>
                  <ColorPicker value={color} onChange={setColor} />
                </div>
                <div className="space-y-2">
                  <Label>Icon</Label>
                  <IconPicker value={icon} color={color} onChange={setIcon} />
                </div>
              </div>
            </div>
          )}
        </DialogContent>
      </Dialog>
    </>
  )
}
</file>

<file path="src/components/confirm-dialog.tsx">
import { createContext, useCallback, useContext, useRef, useState } from 'react'
import {
  AlertDialog,
  AlertDialogAction,
  AlertDialogCancel,
  AlertDialogContent,
  AlertDialogDescription,
  AlertDialogFooter,
  AlertDialogHeader,
  AlertDialogTitle,
} from '@/components/ui/alert-dialog'

interface ConfirmOptions {
  title: string
  description?: string
  confirmText?: string
  cancelText?: string
  destructive?: boolean
}

const ConfirmContext = createContext<(opts: ConfirmOptions) => Promise<boolean>>(() =>
  Promise.resolve(false),
)

export function ConfirmProvider({ children }: { children: React.ReactNode }) {
  const [open, setOpen] = useState(false)
  const [opts, setOpts] = useState<ConfirmOptions | null>(null)
  const resolver = useRef<(value: boolean) => void>(() => {})

  const confirm = useCallback((options: ConfirmOptions) => {
    setOpts(options)
    setOpen(true)
    return new Promise<boolean>((resolve) => {
      resolver.current = resolve
    })
  }, [])

  const settle = (value: boolean) => {
    setOpen(false)
    resolver.current(value)
  }

  return (
    <ConfirmContext.Provider value={confirm}>
      {children}
      <AlertDialog
        open={open}
        onOpenChange={(next) => {
          if (!next) settle(false)
        }}
      >
        <AlertDialogContent>
          <AlertDialogHeader>
            <AlertDialogTitle>{opts?.title}</AlertDialogTitle>
            {opts?.description ? (
              <AlertDialogDescription>{opts.description}</AlertDialogDescription>
            ) : null}
          </AlertDialogHeader>
          <AlertDialogFooter>
            <AlertDialogCancel onClick={() => settle(false)}>
              {opts?.cancelText ?? 'Cancel'}
            </AlertDialogCancel>
            <AlertDialogAction
              variant={opts?.destructive ? 'destructive' : 'default'}
              onClick={() => settle(true)}
            >
              {opts?.confirmText ?? 'Confirm'}
            </AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialogContent>
      </AlertDialog>
    </ConfirmContext.Provider>
  )
}

// eslint-disable-next-line react-refresh/only-export-components
export function useConfirm() {
  return useContext(ConfirmContext)
}
</file>

