<file path="src/components/bookmark-card.tsx">
import { useState } from 'react'
import { Link2, Pencil, Copy, Trash2, Folder } from 'lucide-react'
import type { Bookmark, Collection } from '@/lib/types'
import { extractDomain, formatDate } from '@/lib/utils'
import { ContextMenu } from '@/components/context-menu'

export function BookmarkCard({
  bookmark,
  collection,
  onOpen,
  onEdit,
  onCopy,
  onDelete,
}: {
  bookmark: Bookmark
  collection?: Collection
  onOpen: () => void
  onEdit: () => void
  onCopy: () => void
  onDelete: () => void
}) {
  const [imageFailed, setImageFailed] = useState(false)
  const [faviconFailed, setFaviconFailed] = useState(false)

  return (
    <div className="group relative overflow-hidden rounded-2xl border border-border bg-card shadow-sm transition-all hover:-translate-y-0.5 hover:border-primary/30 hover:shadow-md focus-within:border-primary/40">
      {/* Full-card click target sits behind the content (valid, focusable, no nested buttons). */}
      <button
        type="button"
        aria-label={`Open ${bookmark.title || extractDomain(bookmark.url)}`}
        onClick={onOpen}
        className="absolute inset-0 z-10 cursor-pointer rounded-2xl outline-none focus-visible:ring-3 focus-visible:ring-ring/40"
      />

      <div className="pointer-events-none relative z-20">
        {bookmark.imageUri && !imageFailed ? (
          <img
            src={bookmark.imageUri}
            alt=""
            loading="lazy"
            onError={() => setImageFailed(true)}
            className="aspect-video w-full object-cover"
          />
        ) : null}

        <div className="flex flex-col gap-1.5 p-3">
          {/* Domain row */}
          <div className="flex items-center gap-1.5">
            {bookmark.faviconUri && !faviconFailed ? (
              <img
                src={bookmark.faviconUri}
                alt=""
                loading="lazy"
                onError={() => setFaviconFailed(true)}
                className="size-3.5 shrink-0 rounded-sm"
              />
            ) : (
              <span className="flex size-4 shrink-0 items-center justify-center rounded-sm bg-muted text-primary">
                <Link2 className="size-2.5" />
              </span>
            )}
            <span className="truncate text-[11px] font-medium text-muted-foreground">
              {extractDomain(bookmark.url)}
            </span>
          </div>

          {/* Title */}
          <h3 className="line-clamp-3 text-sm leading-snug font-semibold text-foreground">
            {bookmark.title || extractDomain(bookmark.url)}
          </h3>

          {/* Description */}
          {bookmark.subtitle ? (
            <p className="line-clamp-2 text-xs leading-relaxed text-muted-foreground">{bookmark.subtitle}</p>
          ) : null}

          {/* Footer */}
          <div className="mt-1 flex items-center justify-between gap-2">
            {collection ? (
              <span
                className="inline-flex max-w-[70%] items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-medium"
                style={{ backgroundColor: `${collection.color}22`, color: collection.color }}
              >
                <Folder className="size-2.5 shrink-0" />
                <span className="truncate">{collection.name}</span>
              </span>
            ) : (
              <span className="text-[11px] text-muted-foreground">{formatDate(bookmark.createdAt)}</span>
            )}
            <div className="pointer-events-auto">
              <ContextMenu
                className="-mr-1 opacity-70 group-hover:opacity-100"
                actions={[
                  { label: 'Edit', icon: Pencil, onSelect: onEdit },
                  { label: 'Copy URL', icon: Copy, onSelect: onCopy },
                  { label: 'Delete', icon: Trash2, onSelect: onDelete, destructive: true },
                ]}
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  )
}
</file>

