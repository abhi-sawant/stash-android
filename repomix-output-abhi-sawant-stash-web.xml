import { createContext, useContext, useEffect, useState } from 'react'
import type { AppSettings } from '@/lib/types'

type Resolved = 'light' | 'dark'

const ThemeContext = createContext<Resolved>('light')

function systemTheme(): Resolved {
  return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
}

/**
 * Resolves the active theme from the user's preference (+ the OS setting when
 * "system"), applies the `.dark` class to <html>, and exposes the resolved
 * value to consumers (e.g. the toaster).
 */
export function ThemeProvider({
  preference,
  children,
}: {
  preference: AppSettings['themePreference']
  children: React.ReactNode
}) {
  const [resolved, setResolved] = useState<Resolved>(() =>
    preference === 'system' ? systemTheme() : preference,
  )

  useEffect(() => {
    const apply = () => setResolved(preference === 'system' ? systemTheme() : preference)
    apply()

    if (preference !== 'system') return
    const mql = window.matchMedia('(prefers-color-scheme: dark)')
    mql.addEventListener('change', apply)
    return () => mql.removeEventListener('change', apply)
  }, [preference])

  useEffect(() => {
    const root = document.documentElement
    root.classList.toggle('dark', resolved === 'dark')
    root.style.colorScheme = resolved
  }, [resolved])

  return <ThemeContext.Provider value={resolved}>{children}</ThemeContext.Provider>
}

// eslint-disable-next-line react-refresh/only-export-components
export function useResolvedTheme() {
  return useContext(ThemeContext)
}
</file>

<file path="src/hooks/use-background-sync.ts">
import { useCallback, useEffect, useRef } from 'react'
import { useAuth } from '@/lib/auth-context'
import { useBookmarks } from '@/lib/context'
import { fetchAndMerge, uploadData } from '@/lib/sync'

/**
 * Keeps the local store in sync with the server.
 *
 * Sync happens on app launch and every time the tab comes back to the
 * foreground. The hook fetches the latest server backup, merges it with local
 * data (union of bookmarks by updatedAt, union of collections), then uploads
 * the reconciled result so all other devices see the combined state.
 *
 * Mutations are uploaded separately via the debounced upload inside
 * BookmarksProvider (see lib/context.tsx).
 */
export function useBackgroundSync() {
  const { user } = useAuth()
  const { bookmarks, collections, settings, restore } = useBookmarks()
  const isSyncing = useRef(false)

  const stateRef = useRef({ bookmarks, collections, settings })
  useEffect(() => {
    stateRef.current = { bookmarks, collections, settings }
  }, [bookmarks, collections, settings])

  const performSync = useCallback(async () => {
    if (!user || isSyncing.current) return
    isSyncing.current = true
    try {
      const result = await fetchAndMerge(stateRef.current)
      if (result) {
        restore(result.merged)
        await uploadData(result.merged)
      }
    } catch {
      // Ignore sync errors — will retry on next focus
    } finally {
      isSyncing.current = false
    }
  }, [user, restore])

  useEffect(() => {
    performSync()

    const onVisible = () => {
      if (document.visibilityState === 'visible') performSync()
    }
    document.addEventListener('visibilitychange', onVisible)
    window.addEventListener('focus', performSync)
    return () => {
      document.removeEventListener('visibilitychange', onVisible)
      window.removeEventListener('focus', performSync)
    }
  }, [performSync])
}
</file>

<file path="src/hooks/use-bookmark-actions.ts">
import { useNavigate } from 'react-router-dom'
import { toast } from 'sonner'
import { useBookmarks } from '@/lib/context'
import { useConfirm } from '@/components/confirm-dialog'
import type { Bookmark } from '@/lib/types'

export function useBookmarkActions() {
  const navigate = useNavigate()
  const confirm = useConfirm()
  const { deleteBookmark } = useBookmarks()

  const open = (b: Bookmark) => {
    window.open(b.url, '_blank', 'noopener,noreferrer')
  }

  const copy = async (b: Bookmark) => {
    try {
      await navigator.clipboard.writeText(b.url)
      toast.success('URL copied to clipboard')
    } catch {
      toast.error('Could not copy the URL')
    }
  }

  const edit = (b: Bookmark) => navigate(`/bookmark/${b.id}`)

  const remove = async (b: Bookmark) => {
    const ok = await confirm({
      title: 'Delete bookmark',
      description: `Delete “${b.title || b.url}”? This cannot be undone.`,
      confirmText: 'Delete',
      destructive: true,
    })
    if (ok) {
      deleteBookmark(b.id)
      toast.success('Bookmark deleted')
    }
  }

  return { open, copy, edit, remove }
}
</file>

<file path="src/hooks/use-media-query.ts">
import { useEffect, useState } from 'react'

/** Subscribes to a CSS media query and returns whether it currently matches. */
export function useMediaQuery(query: string): boolean {
  const [matches, setMatches] = useState(() =>
    typeof window !== 'undefined' ? window.matchMedia(query).matches : false,
  )

  useEffect(() => {
    const mql = window.matchMedia(query)
    const onChange = () => setMatches(mql.matches)
    onChange()
    mql.addEventListener('change', onChange)
    return () => mql.removeEventListener('change', onChange)
  }, [query])

  return matches
}
</file>

