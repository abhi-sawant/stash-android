import { useMemo, useState } from 'react'
import { useNavigate } from 'react-router-dom'
import { Bookmark as BookmarkIcon, Plus } from 'lucide-react'
import { Page, PageHeader } from '@/components/layout/page'
import { SearchBar } from '@/components/search-bar'
import { FilterChips } from '@/components/filter-chips'
import { Masonry } from '@/components/masonry'
import { BookmarkCard } from '@/components/bookmark-card'
import { EmptyState } from '@/components/empty-state'
import { Fab } from '@/components/fab'
import { Button } from '@/components/ui/button'
import { useBookmarks } from '@/lib/context'
import { useBookmarkActions } from '@/hooks/use-bookmark-actions'
import { searchFilter } from '@/lib/utils'

export function BookmarksPage() {
  const navigate = useNavigate()
  const { bookmarks, collections } = useBookmarks()
  const actions = useBookmarkActions()

  const [query, setQuery] = useState('')
  const [activeCollectionId, setActiveCollectionId] = useState<string | null>(null)

  const collectionById = useMemo(() => new Map(collections.map((c) => [c.id, c])), [collections])

  const filtered = useMemo(
    () =>
      bookmarks.filter((b) => {
        if (activeCollectionId && b.collectionId !== activeCollectionId) return false
        if (query) return searchFilter(query, b.title, b.subtitle, b.url)
        return true
      }),
    [bookmarks, activeCollectionId, query],
  )

  return (
    <Page>
      <PageHeader
        title="Stash"
        subtitle={`${bookmarks.length} saved ${bookmarks.length === 1 ? 'link' : 'links'}`}
        actions={
          <Button size="icon-lg" aria-label="Add bookmark" onClick={() => navigate('/bookmark/new')} className="lg:hidden">
            <Plus className="size-5" />
          </Button>
        }
      >
        <div className="mt-3">
          <SearchBar value={query} onChange={setQuery} />
        </div>
        <FilterChips collections={collections} activeId={activeCollectionId} onChange={setActiveCollectionId} />
      </PageHeader>

      {filtered.length === 0 ? (
        <EmptyState
          icon={BookmarkIcon}
          title={query || activeCollectionId ? 'No matches found' : 'No bookmarks yet'}
          subtitle={
            query || activeCollectionId
              ? 'Try a different search or filter.'
              : 'Save your first link to start building your collection.'
          }
          action={
            !query && !activeCollectionId ? (
              <Button className="gap-2" onClick={() => navigate('/bookmark/new')}>
                <Plus className="size-4" />
                Add bookmark
              </Button>
            ) : null
          }
        />
      ) : (
        <div className="pt-2">
          <Masonry
            items={filtered}
            getKey={(b) => b.id}
            renderItem={(b) => (
              <BookmarkCard
                bookmark={b}
                collection={b.collectionId ? collectionById.get(b.collectionId) : undefined}
                onOpen={() => actions.open(b)}
                onEdit={() => actions.edit(b)}
                onCopy={() => actions.copy(b)}
                onDelete={() => actions.remove(b)}
              />
            )}
          />
        </div>
      )}

      <Fab icon={Plus} label="Add bookmark" onClick={() => navigate('/bookmark/new')} />
    </Page>
  )
}
</file>

